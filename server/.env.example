# Server
PORT=3000
NODE_ENV=production

# CORS — comma-separated list of allowed origins, or "*" for any
ALLOWED_ORIGINS=*

# Rate limiting — requests per 15-minute window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cache TTL in seconds for repeated extract requests
CACHE_TTL_SECONDS=300

# yt-dlp binary path. If null, the server will use the binary found in PATH.
YTDLP_PATH=

# Optional: cookie file path for sources that require auth (e.g., age-restricted YT)
COOKIES_FILE=

# Request timeout for yt-dlp (ms)
YTDLP_TIMEOUT_MS=30000
